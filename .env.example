# Supabase project -> Settings -> API.
# Only the Project URL and the publishable (sb_publishable_...) or anon public key go here.
# NEVER put a service_role or sb_secret_... key in this app or in any VITE_* variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
